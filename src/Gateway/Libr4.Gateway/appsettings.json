{
  "Jwt": {
    "Issuer": "libr4",
    "Audience": "libr4-clients",
    "SigningKey": "dev-super-secret-change-me-to-random-64-bytes-dev-super-secret-change-me"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "auth", "Match": { "Path": "/api/v1/auth/{**catch-all}" } },
      "auth-health": { "ClusterId": "auth", "Match": { "Path": "/api/v1/auth/health" }, "Transforms": [{ "PathPattern": "/health" }] },
      "users": { "ClusterId": "auth", "Match": { "Path": "/api/v1/users/{**catch-all}" } },
      "profiles": { "ClusterId": "auth", "Match": { "Path": "/api/v1/profiles/{**catch-all}" } },
      "verification": { "ClusterId": "auth", "Match": { "Path": "/api/v1/verification/{**catch-all}" } },
      "chat": { "ClusterId": "chat", "Match": { "Path": "/api/v1/chat/{**catch-all}" } },
      "ai-chat": { "ClusterId": "ide", "Match": { "Path": "/api/v1/ai/chat/{**catch-all}" } },
      "ai": { "ClusterId": "ai", "Match": { "Path": "/api/v1/ai/{**catch-all}" } },
      "analytics": { "ClusterId": "analytics", "Match": { "Path": "/api/v1/analytics/{**catch-all}" } },
      "analytics-health": { "ClusterId": "analytics", "Match": { "Path": "/api/v1/analytics/health" }, "Transforms": [{ "PathPattern": "/health" }] },
      "ide": { "ClusterId": "ide", "Match": { "Path": "/api/v1/ide/{**catch-all}" } },
      "ide-health": { "ClusterId": "ide", "Match": { "Path": "/api/v1/ide/health" }, "Transforms": [{ "PathPattern": "/health" }] },
      "ide-agents-hub": { "ClusterId": "ide", "Match": { "Path": "/hubs/agents/{**catch-all}" }, "Metadata": { "HttpVersionPolicy": "RequestVersionExact" } },
      "ide-shadow-hub": { "ClusterId": "ide", "Match": { "Path": "/hubs/shadow-workspace/{**catch-all}" }, "Metadata": { "HttpVersionPolicy": "RequestVersionExact" } },
      "matching": { "ClusterId": "matching", "Match": { "Path": "/api/v1/matching/{**catch-all}" } },
      "payments": { "ClusterId": "payments", "Match": { "Path": "/api/v1/payments/{**catch-all}" } },
      "social": { "ClusterId": "social", "Match": { "Path": "/api/v1/social/{**catch-all}" } },
      "social-v2": { "ClusterId": "social", "Match": { "Path": "/api/v2/social/{**catch-all}" } },
      "social-health": { "ClusterId": "social", "Match": { "Path": "/api/v1/social/health" }, "Transforms": [{ "PathPattern": "/health" }] },
      "tasks": { "ClusterId": "tasks", "Match": { "Path": "/api/v1/tasks/{**catch-all}" } },
      "trading": { "ClusterId": "trading", "Match": { "Path": "/api/v1/trading/{**catch-all}" } },
      "collaboration": { "ClusterId": "collaboration", "Match": { "Path": "/api/v1/collaboration/{**catch-all}" } }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "chat": { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "ai": { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } },
      "analytics": { "Destinations": { "d1": { "Address": "http://localhost:5004/" } } },
      "ide": { "Destinations": { "d1": { "Address": "http://localhost:5005/" } } },
      "matching": { "Destinations": { "d1": { "Address": "http://localhost:5010/" } } },
      "payments": { "Destinations": { "d1": { "Address": "http://localhost:5008/" } } },
      "social": { "Destinations": { "d1": { "Address": "http://localhost:5007/" } } },
      "tasks": { "Destinations": { "d1": { "Address": "http://localhost:5009/" } } },
      "trading": { "Destinations": { "d1": { "Address": "http://localhost:5011/" } } },
      "collaboration": { "Destinations": { "d1": { "Address": "http://localhost:5012/" } } }
    }
  },
  "Logging": {
    "LogLevel": { "Default": "Information" }
  }
}
