{
  "ConnectionStrings": {
    "AIDatabase": "Server=localhost;Database=Libr4AI;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "Libr4AI",
    "Audience": "Libr4AI",
    "Key": "your-super-secret-key-here-change-in-production"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LLM": {
    "DefaultProvider": "openai",
    "RetryCount": 2
  },
  "Cache": {
    "DefaultExpirationMinutes": 5
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowMinutes": 1
  }
}
