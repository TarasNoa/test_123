{
  "AutonomousAppGeneration": {
    "HostProfile": {
      "ActiveProfile": "BatchCi"
    },
    "BenchmarkMode": {
      "EnableBenchmarkMode": true,
      "UseBenchmarkExecutionPath": true
    },
    "BatchLlmProfile": {
      "UseBatchLlmProfile": true,
      "Model": "openai/gpt-4o-mini",
      "DisableStreaming": true,
      "EnableBenchmarkModeWithBatch": true
    },
    "AgentModels": {
      "ActiveProfile": "Batch"
    },
    "AgentIntegration": {
      "AgentModels": {
        "ActiveProfile": "Batch"
      },
      "BatchCi": {
        "EnableNightlyRegression": true,
        "MaxIterations": 8,
        "TriggerSource": "nightly-ci"
      }
    },
    "AgentStack": {
      "RequireHealthyAtStartup": false,
      "RequireHealthyBeforeRun": false
    }
  },
  "ProviderCapabilityMatrix": {
    "DefaultProvider": "openrouter"
  },
  "AI": {
    "DefaultProvider": "OpenRouter",
    "GpuThrottle": {
      "Enabled": false
    },
    "OpenRouter": {
      "DefaultModel": "openai/gpt-4o-mini",
      "UseStreaming": false,
      "MaxTokens": 4096
    }
  }
}
