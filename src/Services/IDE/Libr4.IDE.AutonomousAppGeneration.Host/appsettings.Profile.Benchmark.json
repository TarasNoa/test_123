{
  "AutonomousAppGeneration": {
    "HostProfile": {
      "ActiveProfile": "Benchmark"
    },
    "BenchmarkMode": {
      "EnableBenchmarkMode": true,
      "UseBenchmarkExecutionPath": true,
      "SkipReviewGate2": true,
      "DeferSecurityReviewFailures": true,
      "SkipSecurityReviewOnLlmFailure": true,
      "ForceExcludeInfrastructurePhases": true,
      "SkipMultiAgentLlmReview": true,
      "RelaxProductionReadinessGates": true,
      "DeferProductionReadinessScoring": true,
      "SkipStrictGenerationGate": true,
      "ApplyManifestRepairOnGenerationGateFailure": true,
      "UseSafeDefaultsOnPlanValidationFailure": true,
      "DeferManifestCoverageGateFailure": true
    },
    "BatchLlmProfile": {
      "UseBatchLlmProfile": false
    },
    "AgentModels": {
      "ActiveProfile": "Auto"
    },
    "AgentIntegration": {
      "AgentModels": {
        "ActiveProfile": "Auto"
      },
      "Verify": {
        "RequirePassInProduction": false
      }
    },
    "AgentStack": {
      "RequireHealthyAtStartup": false,
      "RequireHealthyBeforeRun": false,
      "EnableShadowSyncGate": false,
      "EnableSandboxControllerGate": false,
      "EnableSecurityScannerGate": false,
      "EnableQdrantGate": false
    }
  },
  "ProviderCapabilityMatrix": {
    "DefaultProvider": "dockermodelrunner"
  },
  "AI": {
    "DefaultProvider": "DockerModelRunner",
    "GpuThrottle": {
      "Enabled": true
    }
  }
}
