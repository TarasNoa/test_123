{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/autonomous-app-generation-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "AutonomousAppGeneration": {
    "RuntimeProvider": "docker",
    "AllowProcessFallback": true,
    "LoopGuard": {
      "NoProgressThreshold": 3,
      "SameErrorThreshold": 5
    },
    "RetryPolicy": {
      "MaxExecutionAttempts": 3,
      "BaseBackoffMs": 500
    },
    "Generation": {
      "InitialBatchSize": 3,
      "MaxBatchAttempts": 2,
      "LlmStepTimeoutSeconds": 180,
      "MaxManifestFiles": 40,
      "MaxFilesToPatchPerIteration": 8,
      "MaxRelativeFileRewriteRatio": 0.75,
      "AllowFullRewriteIfFileSmallerThanChars": 240
    },
    "QualityGates": {
      "EnableIntentHeuristics": true,
      "PlanMinScore": 7,
      "ConsistencyMinScore": 7,
      "GenerationMinScore": 7,
      "BuildMinScore": 7,
      "ExecutionMinScore": 7,
      "FixMinScore": 7
    },
    "BenchmarkExport": {
      "ExportRootPath": "d:/lib4_project/artifacts/benchmark-exports",
      "RetentionHours": 48,
      "MaxArtifacts": 500
    },
    "DiagnosticsExport": {
      "ExportRootPath": "d:/lib4_project/artifacts/diagnostics-exports",
      "RetentionHours": 72,
      "MaxArtifacts": 500
    },
    "RuntimePolicy": {
      "MaxCommandTimeoutSeconds": 600,
      "DenyCommandContains": [
        "rm -rf /",
        "mkfs",
        "shutdown",
        "reboot",
        "halt",
        ":(){ :|:& };:",
        "dd if="
      ]
    },
    "AgentIntegration": {
      "Mcp": {
        "EnableStdioTransport": true,
        "KillSwitchBrowserLane": false,
        "KillSwitchN8nLane": false,
        "KillSwitchWorkflowLane": false,
        "DefaultTimeoutMs": 60000,
        "MaxToolCallsPerRun": 128,
        "MaxConcurrentStandaloneInvocations": 8,
        "EnableDeterministicFallback": true,
        "ServerProfiles": {
          "libr4-agent-bridge": {
            "FileName": "python",
            "Arguments": [
              "d:/lib4_project/agent-bridge-mcp/server.py",
              "--db",
              "d:/lib4_project/agent_bridge.db",
              "--channel",
              "d:/lib4_project/AGENT_SYNC_CHANNEL.txt"
            ]
          },
          "browser-lane": {
            "FileName": "node",
            "Arguments": [
              "d:/lib4_project/browser-mcp-server/server.js"
            ],
            "WorkingDirectory": "d:/lib4_project/browser-mcp-server"
          },
          "n8n-lane": {
            "FileName": "node",
            "Arguments": [
              "d:/lib4_project/n8n-mcp-server/server.js"
            ],
            "WorkingDirectory": "d:/lib4_project/n8n-mcp-server"
          }
        },
        "BrowserProfiles": {
          "smoke": {
            "ProfileType": "smoke",
            "BaseUrl": "http://localhost:5200",
            "TimeoutMs": 30000,
            "ScreenshotPath": "d:/lib4_project/artifacts/screenshots",
            "Environment": {
              "HEADLESS": "true"
            }
          },
          "auth": {
            "ProfileType": "auth",
            "BaseUrl": "http://localhost:5200",
            "TimeoutMs": 60000,
            "ScreenshotPath": "d:/lib4_project/artifacts/screenshots",
            "Environment": {
              "HEADLESS": "true",
              "AUTH_TEST_USER": "test@example.com",
              "AUTH_TEST_PASS": "test123"
            }
          }
        },
        "N8nProfiles": {
          "workflow_test": {
            "ProfileType": "workflow_test",
            "WorkflowId": "test-workflow-001",
            "TimeoutMs": 60000,
            "SafeMode": true,
            "Environment": {
              "N8N_API_URL": "http://localhost:5678",
              "N8N_API_KEY": "test-key"
            }
          }
        }
      },
      "McpPolicy": {
        "MaxAllowedRisk": "High",
        "BlockPotentialPhiPatterns": true,
        "DeniedToolNames": []
      },
      "SecurityReview": {
        "MinScore": 7
      },
      "ContextPack": {
        "DefaultMaxChars": 8000,
        "PlanningMaxChars": 9000,
        "GenerationMaxChars": 8000,
        "ConsistencyMaxChars": 7000,
        "FixingMaxChars": 10000,
        "BuildMaxChars": 7000,
        "ExecutionMaxChars": 7000,
        "MaxFilesListed": 40,
        "MaxRecentErrors": 8,
        "MemoryTopK": 12,
        "MaxMemoryItemsInPack": 12
      },
      "CascadePlanner": {
        "EnableLlmAssistedPass": true,
        "EnableWebPrefetchContext": false,
        "PrefetchToolName": "browser.smoke",
        "MaxPrefetchContextChars": 600,
        "ModelRoutingProfile": "auto",
        "LocalModel": "qwen35b",
        "ApiModel": "qwen3.6-plus"
      }
    }
  },
  "ProviderCapabilityMatrix": {
    "LocalModel": "huggingface.co/hesamation/qwen3.6-35b-a3b-claude-4.6-opus-reasoning-distilled-gguf:Q4_K_M",
    "DefaultProvider": "alibabacloud",
    "FallbackModel": "qwen3.6-plus",
    "ApiModel": "qwen3.6-plus"
  },
  "AI": {
    "DefaultProvider": "AlibabaCloud",
    "Ollama": {
      "Endpoint": "http://localhost:11434/api",
      "DefaultModel": "qwen35b"
    },
    "DockerModelRunner": {
      "Endpoint": "http://localhost:12434/engines/v1",
      "DefaultModel": "huggingface.co/hesamation/qwen3.6-35b-a3b-claude-4.6-opus-reasoning-distilled-gguf:Q4_K_M"
    },
    "AlibabaCloud": {
      "ApiKey": "",
      "Endpoint": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
      "DefaultModel": "qwen3.6-plus"
    },
    "OpenRouter": {
      "ApiKey": "",
      "Endpoint": "https://openrouter.ai/api/v1",
      "DefaultModel": "deepseek/deepseek-chat"
    }
  }
}
