{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/autonomous-app-generation-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Obscura": {
    "GrpcEndpoint": "http://localhost:50052",
    "CdpFallback": "http://localhost:9222",
    "DbPath": ".libr4/obscura-sessions.db",
    "MaxConcurrentSessions": 10,
    "PortRangeStart": 9222,
    "PortRangeEnd": 9250,
    "LeaseTimeoutMinutes": 30,
    "JanitorEnabled": true,
    "JanitorIntervalSeconds": 60,
    "EvidenceRoot": ".logs/runs",
    "RunsRoot": ".logs/runs",
    "FrameIntervalMs": 500,
    "MaxFrames": 120,
    "AllowedHostPatterns": [
      "localhost",
      "127.0.0.1",
      "*.local",
      "host.docker.internal"
    ],
    "DockerBrowserHost": "host.docker.internal",
    "UseDockerHostMapping": true,
    "ReadinessMaxAttempts": 30,
    "ReadinessPollIntervalMs": 2000,
    "ReadinessRequestTimeoutSeconds": 5,
    "EnableCdpFallback": true,
    "RequireHealthyAtStartup": false,
    "HealthCheckTimeoutSeconds": 5,
    "EnablePoolAutoscaling": true,
    "MinPoolSessions": 2,
    "PoolScaleUpFactor": 1.25,
    "PoolScalerIntervalSeconds": 60,
    "EnableStealthUserAgentRotation": true,
    "EnablePostVerifySecurityScan": true,
    "SecurityScannerBaseUrl": "http://localhost:7070",
    "ProxyProfiles": {}
  },
  "AutonomousAppGeneration": {
    "RuntimeProvider": "docker",
    "AllowProcessFallback": true,
    "WarmCache": {
      "Enabled": true,
      "PrewarmOnHostStartup": true
    },
    "AgentRuntime": {
      "UseAgentRuntimeRepair": true,
      "UseAgentRuntimeGeneration": true,
      "MaxTurnsPerRepair": 20,
      "MaxTurnsPerGenerationFile": 20,
      "MaxInvestigationToolsBeforeWriteNudge": 3,
      "LlmRetryAttempts": 3,
      "EnableRawContentCoercion": true,
      "EnableToolCallRecovery": true,
      "EnableBoilerplateFallback": true,
      "MaxToolResultChars": 12000,
      "ConversationCharBudget": 48000,
      "EnforceReadBeforeWrite": true,
      "MaxReadFileBytes": 512000,
      "BashTimeoutSeconds": 300,
      "AllowBashDuringGeneration": false,
      "MaxSubagentDepth": 1,
      "EnableMcpToolsInAgentLoop": true,
      "EnableSkillToolsInAgentLoop": true,
      "EnableSubagentTool": true,
      "EnablePlanModeTools": true,
      "EnableRepairPlaybook": true,
      "EnableSessionPersistence": true,
      "EnableRolloutRecorder": true,
      "EnableNdjsonEvents": true,
      "EnableStrictToolSchemaValidation": true,
      "IncludeReasoningInContext": false,
      "SessionDbPath": ".logs/agent-runtime/sessions.db",
      "RolloutDbPath": ".logs/agent-runtime/rollout.db",
      "RunsRoot": ".logs/runs",
      "ExecPolicyPath": "AgentRuntime/Config/execpolicy.yaml",
      "DefaultPermissionMode": "BypassPermissions",
      "Libr4Context": {
        "EnableJitInjection": true,
        "MaxCharsPerInjection": 2000
      }
    },
    "AgentHooks": {
      "Hooks": []
    },
    "LoopGuard": {
      "UsePipelineRunnerForFullHandle": true,
      "NoProgressThreshold": 3,
      "SameErrorThreshold": 3,
      "EnableRootCauseEscalation": true,
      "MaxStartupBuildRemediationPasses": 5,
      "UseStagedBuildRetest": true,
      "MaxPostFixCompileVerifications": 2,
      "AllowBankingBypassWithoutGreenBuild": false,
      "LlmFixerEscalationAfterIteration": 2,
      "UseClaudeCodeStyleRepair": true,
      "SurgicalRepairFromIteration": 1,
      "MaxSurgicalEditsPerIteration": 6,
      "UseFimRepair": true,
      "FimMinFileLines": 200,
      "FimHoleRadiusLines": 4,
      "ResumeFixOnlyFastPath": true
    },
    "Verify": {
      "Enabled": true,
      "EnableAgentSubagent": true,
      "EnableObscuraSmokeRunner": true,
      "EvidenceRoot": ".logs/runs",
      "RequirePassInProduction": true
    },
    "RetryPolicy": {
      "MaxExecutionAttempts": 3,
      "BaseBackoffMs": 500
    },
    "Generation": {
      "InitialBatchSize": 3,
      "MaxBatchAttempts": 2,
      "LlmStepTimeoutSeconds": 180,
      "MaxManifestFiles": 40,
      "MaxFilesToPatchPerIteration": 16,
      "MaxRelativeFileRewriteRatio": 0.75,
      "AllowFullRewriteIfFileSmallerThanChars": 240
    },
    "MultiAgent": {
      "RunPhasesInParallel": false,
      "ExcludeInfrastructurePhases": true,
      "UseFocusedFullStackPhases": true,
      "SkipLlmReviewWhenParseableFiles": true,
      "MaxLlmReviewRounds": 0,
      "RunNestedSubtasksInParallel": false,
      "UseParallelTasksPerPhase": false,
      "MaxConcurrentTasks": 1,
      "UseIncrementalFileScopedGeneration": true,
      "MaxFilesPerIncrementalTask": 6,
      "UseFeatureScopedGeneration": true,
      "IncrementalEmptyBatchMaxRetries": 2,
      "MaxExistingFileContentChars": 2500,
      "MaxExistingFilesInPrompt": 10,
      "SkipIncrementalTaskWhenTargetExists": true,
      "MinCharsToSkipIncrementalTask": 80,
      "UseExpandedJavaReactManifest": true,
      "IncrementalSeedMode": "None",
      "RejectUnplannedGeneratedPaths": true,
      "RequiredManifestCoveragePercent": 75
    },
    "QualityGates": {
      "EnableIntentHeuristics": true,
      "PlanMinScore": 7,
      "ConsistencyMinScore": 7,
      "GenerationMinScore": 7,
      "BuildMinScore": 7,
      "ExecutionMinScore": 7,
      "FixMinScore": 7,
      "MaxGenerationRemediationAttempts": 5
    },
    "BenchmarkMode": {
      "EnableBenchmarkMode": false,
      "SkipReviewGate2": true,
      "DeferSecurityReviewFailures": true,
      "SkipSecurityReviewOnLlmFailure": true,
      "ForceExcludeInfrastructurePhases": true,
      "SkipMultiAgentLlmReview": true,
      "RelaxProductionReadinessGates": true,
      "DeferProductionReadinessScoring": true,
      "SkipStrictGenerationGate": true,
      "ApplyManifestRepairOnGenerationGateFailure": true,
      "UseSafeDefaultsOnPlanValidationFailure": true,
      "DeferManifestCoverageGateFailure": true,
      "UseBenchmarkExecutionPath": true
    },
    "PlatformUtilization": {
      "EnableFullPlatformUtilization": true,
      "InjectCapabilityBriefing": true,
      "CapabilityBriefingMode": "Scoped",
      "MaxBriefingChars": 4500,
      "AutoActivateStackSkills": true,
      "EnableCascadePrefetch": true,
      "WarmMcpRunHost": true,
      "PrefetchRunMemory": true,
      "EnableOrchestratorJitInjection": true,
      "EnableOrchestratorJitLearnedPlaybook": true
    },
    "BenchmarkExport": {
      "ExportRootPath": "/artifacts/benchmark-exports",
      "RetentionHours": 48,
      "MaxArtifacts": 500
    },
    "DiagnosticsExport": {
      "ExportRootPath": "/artifacts/diagnostics-exports",
      "RetentionHours": 72,
      "MaxArtifacts": 500
    },
    "RuntimePolicy": {
      "MaxCommandTimeoutSeconds": 600,
      "DenyCommandContains": [
        "rm -rf /",
        "mkfs",
        "shutdown",
        "reboot",
        "halt",
        ":(){ :|:& };:",
        "dd if="
      ]
    },
    "AgentIntegration": {
      "Mcp": {
        "EnableStdioTransport": true,
        "BrowserLane": {
          "Provider": "Obscura",
          "DeprecationNotice": "browser-mcp-server (Node lane) is deprecated; use Obscura native browser plane."
        },
        "KillSwitchBrowserLane": false,
        "KillSwitchN8nLane": false,
        "KillSwitchWorkflowLane": false,
        "DefaultTimeoutMs": 60000,
        "MaxToolCallsPerRun": 128,
        "MaxConcurrentStandaloneInvocations": 8,
        "EnableDeterministicFallback": false,
        "ServerProfiles": {
          "libr4-agent-bridge": {
            "FileName": "python",
            "Arguments": [
              "D:/lib4_project/agent-bridge-mcp/server.py",
              "--db",
              "D:/lib4_project/agent_bridge.db",
              "--channel",
              "D:/lib4_project/AGENT_SYNC_CHANNEL.txt"
            ]
          },
          "n8n-lane": {
            "FileName": "node",
            "Arguments": [
              "D:/lib4_project/n8n-mcp-server/server.js"
            ],
            "WorkingDirectory": "D:/lib4_project/n8n-mcp-server"
          }
        },
        "BrowserProfiles": {
          "smoke": {
            "ProfileType": "smoke",
            "BaseUrl": "http://localhost:5200",
            "TimeoutMs": 30000,
            "ScreenshotPath": "/artifacts/screenshots",
            "Environment": {
              "HEADLESS": "true"
            }
          },
          "auth": {
            "ProfileType": "auth",
            "BaseUrl": "http://localhost:5200",
            "TimeoutMs": 60000,
            "ScreenshotPath": "/artifacts/screenshots",
            "Environment": {
              "HEADLESS": "true",
              "AUTH_TEST_USER": "test@example.com",
              "AUTH_TEST_PASS": "test123"
            }
          }
        },
        "N8nProfiles": {
          "workflow_test": {
            "ProfileType": "workflow_test",
            "WorkflowId": "test-workflow-001",
            "TimeoutMs": 60000,
            "SafeMode": true,
            "Environment": {
              "N8N_API_URL": "http://localhost:5678",
              "N8N_API_KEY": "test-key"
            }
          }
        }
      },
      "McpHost": {
        "EnableUnifiedHost": true,
        "EnableStdioTransport": true,
        "EnableSseTransport": true,
        "RunSessionIdleTimeoutMinutes": 30,
        "DiscoveryTimeoutSeconds": 8,
        "SseServers": {}
      },
      "LspBridge": {
        "Enabled": true,
        "EnableProcessServers": false,
        "MaxDiagnosticsPerFile": 16,
        "RequestTimeoutSeconds": 10,
        "Servers": {
          "typescript": {
            "FileName": "typescript-language-server",
            "Arguments": ["--stdio"],
            "LanguageIds": ["typescript", "javascript"]
          },
          "csharp": {
            "FileName": "csharp-ls",
            "Arguments": [],
            "LanguageIds": ["csharp"]
          }
        }
      },
      "ShadowGit": {
        "Enabled": true,
        "MaxDiffChars": 8000
      },
      "WorkspaceTrust": {
        "Enabled": true,
        "DbPath": ".logs/workspace-trust.db",
        "BypassTrustStore": false,
        "DefaultSandboxPolicy": "Standard",
        "DefaultHostMode": "CloudAllowed"
      },
      "BatchLlmProfile": {
        "UseBatchLlmProfile": false,
        "Model": "openai/gpt-4o-mini",
        "DisableStreaming": true,
        "EnableBenchmarkModeWithBatch": true
      },
      "BatchCi": {
        "EnableNightlyRegression": true,
        "MaxIterations": 8,
        "TriggerSource": "nightly-ci"
      },
      "AgentScheduling": {
        "Enabled": false,
        "UseMassTransit": false,
        "DbPath": ".logs/agent-schedules.db",
        "PollIntervalSeconds": 60,
        "TriggerSource": "scheduled",
        "Flows": [
          {
            "FlowName": "calorie-django-solidjs",
            "CronExpression": "0 2 * * *",
            "Prompt": "/flow:calorie-django-solidjs scheduled regression run",
            "MaxIterations": 8,
            "Enabled": true
          },
          {
            "FlowName": "banking-java-react",
            "CronExpression": "0 3 * * *",
            "Prompt": "/flow:banking-java-react scheduled regression run",
            "MaxIterations": 8,
            "Enabled": true
          },
          {
            "FlowName": "nextjs-shop",
            "CronExpression": "0 4 * * *",
            "Prompt": "/flow:nextjs-shop scheduled regression run",
            "MaxIterations": 8,
            "Enabled": true
          }
        ]
      },
      "GitHubShip": {
        "Enabled": false,
        "Owner": "",
        "Repository": "",
        "PersonalAccessToken": "",
        "BaseBranch": "main",
        "BranchPrefix": "libr4/autogen-",
        "RequireVerifyPass": true,
        "DispatchWorkflow": true,
