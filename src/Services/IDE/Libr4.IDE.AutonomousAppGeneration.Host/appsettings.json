          "repair": {
            "OpenRouterModel": "openai/gpt-4o",
            "DmrModel": "huggingface.co/jackrong/qwopus3.5-9b-coder-gguf:Q4_K_M",
            "BatchModel": "openai/gpt-4o-mini",
            "FallbackChain": [
              "huggingface.co/hesamation/qwen3.6-35b-a3b-claude-4.6-opus-reasoning-distilled-gguf:Q4_K_M"
            ]
          },
          "computer": {
            "OpenRouterModel": "openai/gpt-4o-mini",
            "DmrModel": "huggingface.co/jackrong/qwopus3.5-9b-coder-gguf:Q4_K_M",
            "BatchModel": "openai/gpt-4o-mini",
            "FallbackChain": []
          }
        }
      },
      "McpPolicy": {
        "MaxAllowedRisk": "High",
        "BlockPotentialPhiPatterns": true,
        "DeniedToolNames": []
      },
      "SecurityReview": {
        "MinScore": 7,
        "Mode": "llm",
        "MaxFilesToReview": 16,
        "MaxCharsPerFile": 2800,
        "MaxTotalPromptChars": 48000,
        "MaxRemediationAttempts": 5
      },
      "ContextPack": {
        "UseRepoGraphOrdering": true,
        "DefaultMaxChars": 8000,
        "PlanningMaxChars": 9000,
        "GenerationMaxChars": 16000,
        "ConsistencyMaxChars": 7000,
        "FixingMaxChars": 16000,
        "VerifyMaxChars": 8000,
        "BuildMaxChars": 7000,
        "ExecutionMaxChars": 7000,
        "MaxFilesListed": 40,
        "MaxRelatedFilesInPack": 24,
        "MaxRecentErrors": 8,
        "MemoryTopK": 12,
        "MaxMemoryItemsInPack": 12
      },
      "Verify": {
        "Enabled": true,
        "EnableAgentSubagent": true,
        "EvidenceRoot": ".logs/runs",
        "RequirePassInProduction": true
      },
      "CascadePlanner": {
        "EnableLlmAssistedPass": true,
        "EnableWebPrefetchContext": true,
        "EnableCodebasePrefetchContext": true,
