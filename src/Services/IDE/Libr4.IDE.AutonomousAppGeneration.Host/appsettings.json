        "CreatePullRequest": true,
        "RequireShipSuccess": false,
        "MaxFilesPerPullRequest": 400,
        "MaxFileBytes": 524288,
        "AttachObscuraManifestComment": true,
        "PublicApiBaseUrl": ""
