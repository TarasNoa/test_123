      "HonchoMemory": {
        "Enabled": true,
        "ApiBaseUrl": "https://api.honcho.dev",
        "ApiKey": "",
        "WorkspaceId": "libr4",
        "AgentPeerId": "libr4-agent",
        "UseRemoteDialectic": false,
        "FallbackToLocalPersona": true,
        "PersonaRoot": ".libr4/users",
        "DefaultReasoningLevel": "low",
        "MaxPlanningChars": 2500,
        "MaxPersonaConclusions": 24
      },
      "LiveSearch": {
        "Enabled": true,
        "MaxRequestsPerMinute": 20,
        "CacheTtlSeconds": 900,
        "MaxResults": 8,
        "MaxSnippetChars": 500,
        "MaxResponseChars": 12000,
        "DefaultWebProvider": "duckduckgo",
        "BraveApiKey": "",
        "XApiBearerToken": "",
