          "verify": {
            "OpenRouterModel": "openai/gpt-4o-mini",
            "DmrModel": "huggingface.co/hesamation/qwen3.6-35b-a3b-claude-4.6-opus-reasoning-distilled-gguf:Q4_K_M",
            "BatchModel": "openai/gpt-4o-mini",
