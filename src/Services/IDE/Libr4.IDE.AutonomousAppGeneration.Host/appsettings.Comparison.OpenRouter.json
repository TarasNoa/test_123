{
  "ProviderCapabilityMatrix": {
    "DefaultProvider": "openrouter",
    "ApiModel": "deepseek/deepseek-v4-flash",
    "FallbackModel": "deepseek/deepseek-v4-flash",
    "ReasoningModel": "deepseek/deepseek-v4-flash",
    "CodeGenerationModel": "deepseek/deepseek-v4-flash",
    "LocalModel": "deepseek/deepseek-v4-flash"
  },
  "AI": {
    "DefaultProvider": "OpenRouter",
    "GpuThrottle": {
      "Enabled": false
    },
    "OpenRouter": {
      "DefaultModel": "deepseek/deepseek-v4-flash",
      "TimeoutMinutes": 15,
      "UseStreaming": true,
      "DisableReasoning": true,
      "Temperature": 0.3,
      "MaxTokens": 8192
    }
  },
  "AutonomousAppGeneration": {
    "Generation": {
      "LlmStepTimeoutSeconds": 900
    },
    "AgentIntegration": {
      "CascadePlanner": {
        "ApiModel": "deepseek/deepseek-v4-flash",
        "EnableLlmAssistedPass": true
      }
    }
  }
}
