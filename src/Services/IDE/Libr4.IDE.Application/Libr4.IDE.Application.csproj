<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Libr4.Shared.Kernel\Libr4.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\Libr4.Shared.Infrastructure\Libr4.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\Libr4.IDE.Domain\Libr4.IDE.Domain.csproj" />
    <ProjectReference Include="..\Libr4.IDE.Domain.Algorithms\Libr4.IDE.Domain.Algorithms.fsproj" />
    <ProjectReference Include="..\Libr4.IDE.Domain.FSharp\Libr4.IDE.Domain.FSharp.fsproj" />
    <!-- <ProjectReference Include="..\Libr4.IDE.AutonomousAppGeneration\Libr4.IDE.AutonomousAppGeneration.csproj" /> -->
    <ProjectReference Include="..\..\AI\Libr4.AI.Domain.Terminal\Libr4.AI.Domain.Terminal.csproj" />
    <ProjectReference Include="..\..\AI\Libr4.AI.Application\Libr4.AI.Application.csproj" />
    <ProjectReference Include="..\..\AI\Libr4.AI.Infrastructure\Libr4.AI.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Libr4.AI.Domain.Terminal" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    
    <!-- gRPC for Rust container-runtime communication -->
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    
    <!-- Git automation -->
    <PackageReference Include="LibGit2Sharp" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  
  <!-- Protobuf - enabled for Docker build -->
  <ItemGroup>
    <Protobuf Include="ShadowWorkspace\Protos\container_runtime.proto" GrpcServices="Client" />
    <Protobuf Include="Obscura\Protos\browser_automation.proto" GrpcServices="Client" />
  </ItemGroup>

  <!-- Files excluded for local build - enabled in Docker -->
  <ItemGroup>
    <Compile Remove="Orchestration\ResilientOrchestrator.cs" /> <!-- Moved to Infrastructure -->
    <Compile Remove="Services\AgentOrchestrator.cs" /> <!-- Moved to Infrastructure -->
    <Compile Remove="MultiAgentOrchestration\HierarchicalOrchestrationService.cs" />
    <!-- SecurityTesting and CodeSearch re-enabled after fixing static _logger issue -->
  </ItemGroup>

</Project>
