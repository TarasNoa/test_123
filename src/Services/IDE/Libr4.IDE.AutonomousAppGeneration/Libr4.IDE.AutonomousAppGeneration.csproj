    <RootNamespace>Libr4.IDE.Application.AutonomousAppGeneration</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Libr4.IDE.Application\Libr4.IDE.Application.csproj" />
