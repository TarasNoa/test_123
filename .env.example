# ─── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=libr4
POSTGRES_PASSWORD=libr4_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── JWT ────────────────────────────────────────────────────
JWT_ISSUER=libr4
JWT_AUDIENCE=libr4-clients
# Dev-only 32+ byte secret. ROTATE IN PRODUCTION.
JWT_SIGNING_KEY=dev-super-secret-change-me-to-random-64-bytes-dev-super-secret-change-me

# ─── Stripe (Payments service) ─────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── AI (Ollama + OpenAI-compatible) ───────────────────────
# Local LLM inference (recommended models):
# - qwen3-coder-next : IDE autocomplete, code generation (80B MoE, 3B active)
# - qwen3:8b         : AI chat, reasoning, RAG backend (8B params)
# - granite:1b       : Quick scoring, categorization (1.6B params)
# - stable-code:3b   : Lightweight autocomplete for low-end devices
#
# Run: docker compose up -d ollama
# Then: docker exec -it libr4-ollama ollama pull qwen3-coder-next
OLLAMA_BASE_URL=http://localhost:11434

# Cloud AI (optional, fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:5000
